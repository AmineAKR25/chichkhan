{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["fra1"],
  "rewrites": [
    {
      "source": "/:venue(restaurant|cafe)",
      "destination": "/api/menu?venue=:venue"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/restaurant",
      "permanent": false
    },
    {
      "source": "/menu-1",
      "destination": "/restaurant",
      "permanent": true
    },
    {
      "source": "/menu-2",
      "destination": "/cafe",
      "permanent": true
    }
  ]
}
