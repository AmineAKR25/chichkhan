{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["fra1"],
  "rewrites": [
    {
      "source": "/:venue(restaurant|cafe)",
      "destination": "/api/menu?venue=:venue"
    },
    {
      "source": "/admin",
      "destination": "/api/admin?page=dashboard"
    },
    {
      "source": "/admin/:page(login|logout|cafe|restaurant)",
      "destination": "/api/admin?page=:page"
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/restaurant",
      "permanent": false
    },
    {
      "source": "/menu-1",
      "destination": "/restaurant",
      "permanent": true
    },
    {
      "source": "/menu-2",
      "destination": "/cafe",
      "permanent": true
    }
  ]
}
