# Copy to .env.local for local development, and set the same variables in
# Vercel (Project → Settings → Environment Variables). For a throwaway local
# database and admin sign-in, run `npm run local:setup` instead: it writes
# local-only values into .env.local for you.

# Neon pooled connection string, ideally for the read-only menu_site role.
# Without it, /restaurant and /cafe show "La carte est momentanément indisponible."
DATABASE_URL=

# Public base URL of the Cloudflare R2 bucket, e.g. https://images.example.com
# Without it, every image shows its coloured placeholder.
R2_PUBLIC_BASE_URL=

# --- /admin -------------------------------------------------------------------
# The console has no public door: without the three secrets below, /admin
# answers 404 on Vercel and nobody can sign in. Create them with:
#   npm run admin:password
# Optional. Not a credential and never typed in: it is only the name the change
# history files edits under. Defaults to "Propriétaire".
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Changing it signs everyone out.
ADMIN_SESSION_SECRET=
# At least 32 random characters. Encrypts the private owner link, which is the
# only unauthenticated way to reach the password screen. Print a link with:
#   npm run admin:link -- https://your-site.com [days|toujours]
# Changing this invalidates every link ever issued.
ADMIN_LINK_SECRET=

# Optional: a Neon connection string for a role that may write the menu
# (menu_admin in README.md). The admin falls back to DATABASE_URL.
ADMIN_DATABASE_URL=

# Photo uploads from /admin: the S3 API of the same R2 bucket. Use an R2 API
# token limited to Object Read & Write on this bucket. Without these, the admin
# works but says "Image uploads are not configured."
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "auto" for R2.
S3_REGION=auto
