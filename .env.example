# Copy to .env.local for local development, and set the same variables in
# Vercel (Project → Settings → Environment Variables).

# Neon pooled connection string, ideally for the read-only menu_site role.
# Without it, /restaurant and /cafe show "La carte est momentanément indisponible."
DATABASE_URL=

# Public base URL of the Cloudflare R2 bucket, e.g. https://images.example.com
# Without it, every image shows its coloured placeholder.
R2_PUBLIC_BASE_URL=
